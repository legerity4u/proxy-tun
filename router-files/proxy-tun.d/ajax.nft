#!/usr/sbin/nft -f
# ajax.nft — Ajax Hub cloud IPs (AWS EU + backup) → PBR через туннель
# Опциональный модуль, подключается из proxy-tun.nft строкой:
#   include "/etc/sing-box/proxy-tun.d/ajax.nft"
#
# Зачем: ISP (Истранет) блокирует IP-диапазоны AWS EU, к которым
# обращается Ajax Hub. Прямой маршрут не работает → @ajax_v4 → tun0.
#
# Идемпотентно: вызывается после flush table из главного файла.
# Не запускать как standalone (нужна существующая таблица proxy_tun).

table inet proxy_tun {
    set ajax_v4 {
        type ipv4_addr
        flags interval
        elements = {
            35.180.2.46,
            63.34.34.82,
            63.32.200.183,
            34.249.240.61,
            194.87.103.60,
            194.87.110.46,
            195.133.49.175,
            167.99.19.236
        }
    }
}

add rule inet proxy_tun prerouting iifname "br-lan" ip daddr @ajax_v4 meta mark set 0x64
