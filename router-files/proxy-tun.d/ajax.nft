#!/usr/sbin/nft -f
# ajax.nft — Ajax Hub cloud IPs → PBR через туннель
# Опциональный модуль, подключается из proxy-tun.nft строкой:
#   include "/etc/sing-box/proxy-tun.d/ajax.nft"
#
# Зачем: ISP (Истранет) блокирует IP-диапазоны облака Ajax. Прямой маршрут
# не работает → @ajax_v4 → tun0.
#
# Источник адресов (2026-10-06): официальный список облака Ajax
# (hts-hub / hts-hubs / hts-gw / hts-logs / hub-gw .prod.ajax.systems),
# фактические DNS-ответы облака на даче и наблюдённый conntrack хаба.
# Порты Ajax Hub: 80, 1789, 2020, 2021, 5057, 5059.
#
# 2026-10-31: удалены 194.87.103.60 / 194.87.110.46 / 195.133.49.175
# (Mediasoft, Королёв) — tarpit: TCP принимают, но данных не отдают,
# в текущем DNS Ajax отсутствуют; хаб долбил их вхолостую.
#
# 2026-11-04: добавлены эндпоинты мобильного приложения. Без них список
# устройств и сопряжение хаба не работают по Wi-Fi без VPN на телефоне:
# ISP режет эти адреса напрямую, приложение показывает кэш и не
# синхронизируется. Источник — захват трафика телефона при сопряжении.
#   mobile-gw / mobile-gw-k8s  (52.30.160.227, 52.211.22.31, 54.77.76.63)
#   app / in-app-message       (65.9.46.0/24 — CloudFront)
#   imagesvc                   (54.75.92.21, 52.49.115.141, 40.180.120.45)
#   api / api.prod             (34.248.245.231, 99.81.42.69, 34.249.38.154)
#   app.ajax.systems           (178.62.78.236)
#   relay.prod.ajax.systems    (95.216.115.22)
# 65.9.46.0/24 — общий CloudFront; в туннель уходят только эти 8 адресов,
# которые реально использует приложение Ajax.
#
# Идемпотентно: вызывается после flush table из главного файла.
# Не запускать как standalone (нужна существующая таблица proxy_tun).

table inet proxy_tun {
    set ajax_v4 {
        type ipv4_addr
        flags interval
        elements = {
            63.34.34.82,        # AWS eu-west-1 (Dublin)
            63.32.200.183,      # AWS eu-west-1 (Dublin)
            34.249.240.61,      # AWS eu-west-1 (Dublin)
            52.57.175.225,      # AWS eu-central-1 (Frankfurt)
            52.57.131.150,      # AWS eu-central-1 (Frankfurt)
            178.62.38.104,      # DigitalOcean (London)
            157.230.78.73,      # DigitalOcean
            167.99.19.236,      # DigitalOcean
            54.216.172.252,     # AWS (hubs-logs.prod.ajax.systems)
            35.180.2.46,        # AWS eu-west-3 (Paris)

            # mobile-gw / mobile-gw-k8s .prod.ajax.systems
            52.30.160.227,
            52.211.22.31,
            54.77.76.63,

            # app / in-app-message .prod.ajax.systems (CloudFront)
            65.9.46.21,
            65.9.46.30,
            65.9.46.72,
            65.9.46.79,
            65.9.46.86,
            65.9.46.100,
            65.9.46.108,
            65.9.46.128,

            # imagesvc / imagesvc-main .prod.ajax.systems
            54.75.92.21,
            52.49.115.141,
            40.180.120.45,

            # api / api.prod .ajax.systems
            34.248.245.231,
            99.81.42.69,
            34.249.38.154,

            # app.ajax.systems / relay.prod.ajax.systems
            178.62.78.236,
            95.216.115.22
        }
    }
}

add rule inet proxy_tun prerouting iifname "br-lan" ip daddr @ajax_v4 counter meta mark set 0x64
