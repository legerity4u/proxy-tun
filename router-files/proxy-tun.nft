#!/usr/sbin/nft -f
# proxy-tun.nft — PBR через туннель + QUIC block
# Loaded separately (NOT via fw4 include) on OpenWrt 25.12.5+
# because fw4 include is inside table inet fw4 and can't contain
# a separate table definition.
#
# Ядро (всегда): @youtube_v4 → fwmark 0x64 → table 100 → tun0
# Опциональные ресурсы — файлы из /etc/sing-box/proxy-tun.d/,
# подключаются include (раскомментируй нужные при деплое).
#
# QUIC block: UDP/443 → @youtube_v4 → drop
# Идемпотентность: полный пересбор таблицы.
# add+delete гарантирует отсутствие таблицы перед декларацией — простой
# `flush` НЕ удаляет цепочки: при перезагрузке оставались цепочки от старых
# версий файла (2026-08-27: осталась цепочка output от откаченной правки).
add table inet proxy_tun
delete table inet proxy_tun

table inet proxy_tun {

    set youtube_v4 {
        type ipv4_addr
        flags interval
        elements = {
            8.8.8.0/24, 8.8.4.0/24,
            64.233.160.0/19, 66.102.0.0/20,
            66.249.64.0/19, 72.14.192.0/18,
            74.125.0.0/16, 108.177.8.0/21,
            142.250.0.0/15, 172.217.0.0/16,
            172.253.0.0/16, 173.194.0.0/16,
            209.85.128.0/17, 216.58.0.0/16,
            216.239.32.0/19, 199.192.112.0/22,
            208.65.152.0/22, 208.117.224.0/19,
            34.64.0.0/10, 34.128.0.0/10,
            35.184.0.0/13, 35.192.0.0/14,
            35.196.0.0/15, 35.198.0.0/16,
            35.199.0.0/17, 35.199.128.0/18,
            35.200.0.0/13, 35.208.0.0/12,
            35.224.0.0/12, 35.240.0.0/13,
            104.154.0.0/15, 104.196.0.0/14,
            107.178.192.0/18, 130.211.0.0/16,
            146.148.0.0/17, 162.222.176.0/21,
            192.178.0.0/15
        }
    }

    chain prerouting {
        type filter hook prerouting priority -200; policy accept;

        iifname "br-lan" ip daddr 192.168.0.0/16 return
        iifname "br-lan" ip daddr 127.0.0.0/8 return
        iifname "br-lan" udp dport 53 return
        iifname "br-lan" tcp dport 53 return
        iifname "br-lan" udp dport { 67, 68 } return
        iifname "br-lan" ip daddr @youtube_v4 counter meta mark set 0x64
    }

    chain forward {
        type filter hook forward priority -200; policy accept;

        iifname "br-lan" udp dport 443 ip daddr @youtube_v4 counter drop
    }
}

# === Опциональные include ===
# Файлы опциональных ресурсов лежат в /etc/sing-box/proxy-tun.d/.
# Раскомментируй строку включения нужного ресурса при деплое на роутер.
# Пример — Ajax Hub (см. proxy-tun.d/ajax.nft):
# include "/etc/sing-box/proxy-tun.d/ajax.nft"
